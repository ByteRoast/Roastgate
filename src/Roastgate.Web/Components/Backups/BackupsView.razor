<div class="rg-page-header">
    <div>
        <MudText Typo="Typo.h4">
            Backups
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary">
            Every change and every deletion keeps the previous content here (the 30 most recent per file). Restoring goes through the same
            test, rollback and reload cycle as a save, and keeps what it replaces.
        </MudText>
    </div>
</div>

<div class="rg-field-row mb-4">
    <MudSelect T="string"
               @bind-Value="_area"
               Label="Area"
               Variant="Variant.Outlined">
        <MudSelectItem T="string"
                       Value="@string.Empty">
            All
        </MudSelectItem>

        @foreach (ConfigArea area in Enum.GetValues<ConfigArea>())
        {
            <MudSelectItem T="string"
                           Value="@area.ToString()">
                @AreaInfo.For(area).Title
            </MudSelectItem>
        }
    </MudSelect>

    <MudTextField T="string"
                  @bind-Value="_name"
                  Label="File name"
                  Variant="Variant.Outlined" />

    <div class="rg-field-action">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="LoadAsync">
            Show
        </MudButton>
    </div>
</div>

<ResultAlert Result="_result"
             Class="mb-4" />

<MudTable T="ConfigBackup"
          Items="_items"
          Loading="_items is null"
          Hover="true"
          Dense="true"
          Outlined="true"
          Elevation="0"
          Breakpoint="Breakpoint.Sm"
          Class="mb-4">
    <HeaderContent>
        <MudTh>
            When
        </MudTh>

        <MudTh>
            File
        </MudTh>

        <MudTh>
            Taken before
        </MudTh>

        <MudTh>
            Size
        </MudTh>

        <MudTh>
        </MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="When">
            @context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        </MudTd>

        <MudTd DataLabel="File">
            <MudText Typo="Typo.caption"
                     Color="Color.Secondary"
                     Class="d-block">
                @AreaTitle(context.Area)
            </MudText>

            @context.Name
        </MudTd>

        <MudTd DataLabel="Taken before">
            @Describe(context.Reason)
        </MudTd>

        <MudTd DataLabel="Size">
            @(context.Content.Length) chars
        </MudTd>

        <MudTd Style="text-align: right">
            <MudButton Size="Size.Small"
                       Variant="@(_selected?.Id == context.Id ? Variant.Filled : Variant.Outlined)"
                       OnClick="@(() => SelectAsync(context))">
                Compare
            </MudButton>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText>
            No backup yet. They appear when a file is changed or deleted from Roastgate.
        </MudText>
    </NoRecordsContent>
</MudTable>

@if (_selected is not null)
{
    <MudPaper Outlined="true"
              Elevation="0"
              Class="pa-4">
        <div class="rg-page-header">
            <div>
                <MudText Typo="Typo.h6">
                    @_selected.Name, as of @_selected.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">
                    @if (_currentContent is null)
                    {
                        <span>
                            The file does not exist any more: restoring creates it again.
                        </span>
                    }
                    else if (_diff is null)
                    {
                        <span>
                            Too many lines to compare here.
                        </span>
                    }
                    else if (!_diff.HasChanges)
                    {
                        <span>
                            Identical to the current file: restoring changes nothing.
                        </span>
                    }
                    else
                    {
                        <span>
                            Restoring <strong class="rg-diff-added-text">adds @_diff.Added line(s)</strong> and <strong class="rg-diff-removed-text">removes @_diff.Removed line(s)</strong> compared with the current file.
                        </span>
                    }
                </MudText>
            </div>

            <div class="rg-page-actions">
                <MudButton Variant="Variant.Outlined"
                           Href="@FileUrl(_selected)">
                    Open the file
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="RestoreAsync"
                           Disabled="_isBusy">
                    Restore this version
                </MudButton>
            </div>
        </div>

        @if (_diff is not null && _currentContent is not null)
        {
            <div class="rg-diff"
                 role="table"
                 aria-label="Differences">
                @foreach (DiffRow row in Rows())
                {
                    if (row.Skipped > 0)
                    {
                        <div class="rg-diff-skip">
                            ... @row.Skipped unchanged line(s) ...
                        </div>
                    }
                    else
                    {
                        <div class="@("rg-diff-line rg-diff-" + row.Line!.Kind.ToString().ToLowerInvariant())">
                            <span class="rg-diff-mark">
                                @(row.Line.Kind == DiffKind.Added ? "+" : row.Line.Kind == DiffKind.Removed ? "-" : " ")
                            </span>

                            <span class="rg-diff-text">
                                @row.Line.Text
                            </span>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <pre class="rg-output rg-preview">@_selected.Content</pre>
        }
    </MudPaper>
}
