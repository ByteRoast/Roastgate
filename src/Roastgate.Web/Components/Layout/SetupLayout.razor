@inherits LayoutComponentBase

<MudThemeProvider Theme="RoastgateTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-8">
    <div class="rg-setup-brand">
        <img src="/img/logo.svg" alt="" class="rg-logo" />
        <MudText Typo="Typo.h5" Class="rg-brand">Roastgate</MudText>
    </div>
    <MudPaper Outlined="true" Elevation="0" Class="pa-6">
        @Body
    </MudPaper>
</MudContainer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
