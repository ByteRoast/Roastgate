<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* The script drives this dialog through the ids and the components-* state classes below: keep them. *@
<dialog id="components-reconnect-modal" data-nosnippet aria-live="assertive">
    <div class="components-reconnect-container">
        <div class="rg-reconnect-icon" aria-hidden="true">
            <div class="components-rejoining-animation"></div>
            <svg class="rg-reconnect-warning components-reconnect-failed-visible components-pause-visible components-resume-failed-visible" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </div>

        <h2 class="components-reconnect-first-attempt-visible">Connection lost</h2>
        <p class="components-reconnect-first-attempt-visible">Trying to reach the server again...</p>

        <h2 class="components-reconnect-repeated-attempt-visible">Still trying</h2>
        <p class="components-reconnect-repeated-attempt-visible">
            The server did not answer. Next attempt in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>

        <h2 class="components-reconnect-failed-visible">Could not reconnect</h2>
        <p class="components-reconnect-failed-visible">The server is unreachable. Retry, or reload the page.</p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">Retry</button>

        <h2 class="components-pause-visible">Session paused</h2>
        <p class="components-pause-visible">The server paused this session. Resume to carry on where you were.</p>

        <h2 class="components-resume-failed-visible">Could not resume</h2>
        <p class="components-resume-failed-visible">The session could not be resumed. Retry, or reload the page.</p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">Resume</button>
    </div>
</dialog>
