@inject ITwoFactorService TwoFactor
@inject AccountService Accounts
@inject LoginThrottle Throttle
@inject IAuditLog Audit
@inject CurrentUser User
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using QRCoder

<MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-1">Two-factor authentication</MudText>

    @if (_recoveryCodes is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            <strong>Save these recovery codes now.</strong> Each one signs you in once if you lose your phone. They are shown only this time.
        </MudAlert>
        <pre class="rg-output rg-recovery-codes" data-testid="recovery-codes">@string.Join('\n', _recoveryCodes)</pre>
        <div class="rg-editor-actions">
            <MudButton Variant="Variant.Outlined" OnClick="CopyCodesAsync">@(_copied ? "Copied" : "Copy the codes")</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueAfterCodesAsync">@(_signInAfterCodes ? "I have saved them, sign in again" : "I have saved them")</MudButton>
        </div>
    }
    else if (_enrollment is not null)
    {
        <MudText Class="mb-3">
            Scan this QR code with an authenticator app (Google Authenticator, Aegis, 1Password, Bitwarden...), then enter the 6-digit code it shows.
        </MudText>
        <div class="rg-qr" role="img" aria-label="QR code to add Roastgate to an authenticator app">@((MarkupString)_qrSvg)</div>
        <MudText Typo="Typo.body2" Class="mt-2">Cannot scan? Enter this key by hand: <code class="rg-secret">@Grouped(_enrollment.Secret)</code></MudText>

        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@string.Join(" ", _errors)</MudAlert>
        }

        <div class="rg-field-row mt-3">
            <MudTextField T="string" @bind-Value="_code" Label="Code from the app" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </div>
        <div class="rg-editor-actions">
            <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmAsync" Disabled="_isBusy">Turn on two-factor authentication</MudButton>
        </div>
    }
    else if (!_enabled)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Off. Turn it on so that a stolen or guessed password is not enough to control your web server.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartAsync">Set up two-factor authentication</MudButton>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">
            Two-factor authentication is <strong>on</strong>. @_remaining recovery code(s) left.
        </MudAlert>

        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@string.Join(" ", _errors)</MudAlert>
        }

        <MudText Typo="Typo.subtitle1" Class="mb-1">Get new recovery codes</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">The old ones stop working. Confirm with a code from your app.</MudText>
        <div class="rg-field-row">
            <MudTextField T="string" @bind-Value="_regenerateCode" Label="Code from the app" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <div><MudButton Variant="Variant.Outlined" OnClick="RegenerateAsync" Disabled="_isBusy">Get new recovery codes</MudButton></div>
        </div>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle1" Class="mb-1">Turn it off</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Needs your password and a code. Every open session ends.</MudText>
        <div class="rg-field-row">
            <MudTextField T="string" @bind-Value="_disablePassword" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_disableCode" Label="Code from the app (or a recovery code)" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <div class="rg-editor-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DisableAsync" Disabled="_isBusy">Turn off two-factor authentication</MudButton>
        </div>
    }
</MudPaper>

@code {
    private readonly List<string> _errors = [];
    private TwoFactorEnrollment? _enrollment;
    private IReadOnlyList<string>? _recoveryCodes;
    private string _qrSvg = string.Empty;
    private string _username = string.Empty;
    private string _code = string.Empty;
    private string _regenerateCode = string.Empty;
    private string _disablePassword = string.Empty;
    private string _disableCode = string.Empty;
    private bool _enabled;
    private bool _copied;
    private bool _isBusy;
    private int _remaining;
    private bool _signInAfterCodes;

    protected override async Task OnInitializedAsync()
    {
        _username = await User.GetNameAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _enabled = await TwoFactor.IsEnabledAsync();
        _remaining = _enabled ? await TwoFactor.RemainingRecoveryCodesAsync() : 0;
    }

    private Task StartAsync()
    {
        _errors.Clear();
        _enrollment = TwoFactor.BeginEnrollment(_username);
        _qrSvg = BuildQrCode(_enrollment.ProvisioningUri);
        _code = string.Empty;
        return Task.CompletedTask;
    }

    private void Cancel()
    {
        _enrollment = null;
        _errors.Clear();
    }

    private async Task ConfirmAsync()
    {
        _errors.Clear();
        if (_enrollment is null)
        {
            return;
        }

        string throttleKey = "two-factor-setup:" + _username;
        if (Throttle.IsBlocked(throttleKey, out TimeSpan retryAfter))
        {
            _errors.Add($"Too many wrong codes. Try again in {Math.Ceiling(retryAfter.TotalMinutes)} minute(s).");
            return;
        }

        _isBusy = true;
        try
        {
            IReadOnlyList<string>? codes = await TwoFactor.ConfirmEnrollmentAsync(_enrollment.Secret, _code);
            if (codes is null)
            {
                Throttle.RecordFailure(throttleKey);
                _errors.Add("That code is not valid. Check that your phone's clock is set automatically, and enter the code the app shows now.");
                return;
            }

            Throttle.Reset(throttleKey);
            await Audit.WriteAsync(_username, "auth.two-factor-enabled", null, true);
            _recoveryCodes = codes;
            _signInAfterCodes = true;
            _enrollment = null;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RegenerateAsync()
    {
        _errors.Clear();
        string throttleKey = "two-factor-confirm:" + _username;
        if (Throttle.IsBlocked(throttleKey, out TimeSpan retryAfter))
        {
            _errors.Add($"Too many wrong codes. Try again in {Math.Ceiling(retryAfter.TotalMinutes)} minute(s).");
            return;
        }

        _isBusy = true;
        try
        {
            if (!await TwoFactor.VerifyAsync(_regenerateCode))
            {
                Throttle.RecordFailure(throttleKey);
                _errors.Add("That code is not valid.");
                return;
            }

            Throttle.Reset(throttleKey);
            _recoveryCodes = await TwoFactor.RegenerateRecoveryCodesAsync();
            _signInAfterCodes = false;
            _regenerateCode = string.Empty;
            await Audit.WriteAsync(_username, "auth.recovery-codes-regenerated", null, true);
            await RefreshAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DisableAsync()
    {
        _errors.Clear();
        string throttleKey = "two-factor-confirm:" + _username;
        if (Throttle.IsBlocked(throttleKey, out TimeSpan retryAfter))
        {
            _errors.Add($"Too many wrong attempts. Try again in {Math.Ceiling(retryAfter.TotalMinutes)} minute(s).");
            return;
        }

        _isBusy = true;
        try
        {
            bool passwordOk = await Accounts.VerifyCredentialsAsync(_username, _disablePassword) is not null;
            bool codeOk = passwordOk && await TwoFactor.VerifyAsync(_disableCode);
            if (!passwordOk || !codeOk)
            {
                Throttle.RecordFailure(throttleKey);
                await Audit.WriteAsync(_username, "auth.two-factor-disable", null, false, passwordOk ? "wrong code" : "wrong password");
                _errors.Add(passwordOk ? "That code is not valid." : "The password is not correct.");
                return;
            }

            await TwoFactor.DisableAsync();
            await Audit.WriteAsync(_username, "auth.two-factor-disabled", null, true);
            Navigation.NavigateTo("/login?notice=two-factor-changed", forceLoad: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CopyCodesAsync()
    {
        if (_recoveryCodes is not null)
        {
            _copied = await JS.InvokeAsync<bool>("roastgateCopy", string.Join('\n', _recoveryCodes));
        }
    }

    private async Task ContinueAfterCodesAsync()
    {
        if (_signInAfterCodes)
        {
            // Turning it on ended every session (the security stamp changed), this one included: sign in again, with a code.
            Navigation.NavigateTo("/login?notice=two-factor-changed", forceLoad: true);
            return;
        }

        // Regenerating codes changes nothing about the sessions.
        _recoveryCodes = null;
        _copied = false;
        await RefreshAsync();
    }

    private static string BuildQrCode(string uri)
    {
        using QRCodeGenerator generator = new();
        using QRCodeData data = generator.CreateQrCode(uri, QRCodeGenerator.ECCLevel.M);
        SvgQRCode svg = new(data);
        return svg.GetGraphic(4, "#1c1e21", "#ffffff", true, SvgQRCode.SizingMode.ViewBoxAttribute);
    }

    /// <summary>The secret in groups of four, which is how it is easiest to type.</summary>
    private static string Grouped(string secret)
    {
        return string.Join(' ', Enumerable.Range(0, (secret.Length + 3) / 4).Select((int group) => secret.Substring(group * 4, Math.Min(4, secret.Length - group * 4))));
    }
}
