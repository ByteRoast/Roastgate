<MudPaper Outlined="true"
          Elevation="0"
          Class="pa-4 mb-4">
    <MudText Typo="Typo.h6"
             Class="mb-1">
        Two-factor authentication
    </MudText>

    @if (_recoveryCodes is not null)
    {
        <MudAlert Severity="Severity.Warning"
                  Class="mb-3">
            <strong>Save these recovery codes now.</strong> Each one signs you in once if you lose your phone. They are shown only this time.
        </MudAlert>

        <pre class="rg-output rg-recovery-codes"
             data-testid="recovery-codes">@string.Join('\n', _recoveryCodes)</pre>

        <div class="rg-editor-actions">
            <MudButton Variant="Variant.Outlined"
                       OnClick="CopyCodesAsync">
                @(_copied ? "Copied" : "Copy the codes")
            </MudButton>

            <MudSpacer />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ContinueAfterCodesAsync">
                @(_signInAfterCodes ? "I have saved them, sign in again" : "I have saved them")
            </MudButton>
        </div>
    }
    else if (_enrollment is not null)
    {
        <MudText Class="mb-3">
            Scan this QR code with an authenticator app (Google Authenticator, Aegis, 1Password, Bitwarden...), then enter the 6-digit code it shows.
        </MudText>

        <div class="rg-qr"
             role="img"
             aria-label="QR code to add Roastgate to an authenticator app">
            @((MarkupString)_qrSvg)
        </div>

        <MudText Typo="Typo.body2"
                 Class="mt-2">
            Cannot scan? Enter this key by hand: <code class="rg-secret">@Grouped(_enrollment.Secret)</code>
        </MudText>

        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error"
                      Class="mt-3">
                @string.Join(" ", _errors)
            </MudAlert>
        }

        <div class="rg-field-row mt-3">
            <MudTextField T="string"
                          @bind-Value="_code"
                          Label="Code from the app"
                          Variant="Variant.Outlined"
                          Immediate="true" />
        </div>

        <div class="rg-editor-actions">
            <MudButton Variant="Variant.Outlined"
                       OnClick="Cancel">
                Cancel
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ConfirmAsync"
                       Disabled="_isBusy">
                Turn on two-factor authentication
            </MudButton>
        </div>
    }
    else if (!_enabled)
    {
        <MudText Typo="Typo.body2"
                 Color="Color.Secondary"
                 Class="mb-3">
            Off. Turn it on so that a stolen or guessed password is not enough to control your web server.
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="StartAsync">
            Set up two-factor authentication
        </MudButton>
    }
    else
    {
        <MudAlert Severity="Severity.Success"
                  Class="mb-3">
            Two-factor authentication is <strong>on</strong>. @_remaining recovery code(s) left.
        </MudAlert>

        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error"
                      Class="mb-3">
                @string.Join(" ", _errors)
            </MudAlert>
        }

        <MudText Typo="Typo.subtitle1"
                 Class="mb-1">
            Get new recovery codes
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary"
                 Class="mb-2">
            The old ones stop working. Confirm with a code from your app.
        </MudText>

        <div class="rg-field-row">
            <MudTextField T="string"
                          @bind-Value="_regenerateCode"
                          Label="Code from the app"
                          Variant="Variant.Outlined" />

            <div class="rg-field-action">
                <MudButton Variant="Variant.Outlined"
                           OnClick="RegenerateAsync"
                           Disabled="_isBusy">
                    Get new recovery codes
                </MudButton>
            </div>
        </div>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle1"
                 Class="mb-1">
            Turn it off
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary"
                 Class="mb-2">
            Needs your password and a code. Every open session ends.
        </MudText>

        <div class="rg-field-row">
            <MudTextField T="string"
                          @bind-Value="_disablePassword"
                          Label="Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined" />

            <MudTextField T="string"
                          @bind-Value="_disableCode"
                          Label="Code from the app (or a recovery code)"
                          Variant="Variant.Outlined" />
        </div>

        <div class="rg-editor-actions">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       OnClick="DisableAsync"
                       Disabled="_isBusy">
                Turn off two-factor authentication
            </MudButton>
        </div>
    }
</MudPaper>
