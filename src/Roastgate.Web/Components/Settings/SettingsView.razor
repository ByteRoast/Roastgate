
<div class="rg-page-header">
    <div>
        <MudText Typo="Typo.h4">
            Settings
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary">
            Where Roastgate finds nginx and Let's Encrypt, your password, and a check of the host.
        </MudText>
    </div>
</div>

<MudPaper Outlined="true"
          Elevation="0"
          Class="pa-4 mb-4">
    <MudText Typo="Typo.h6"
             Class="mb-1">
        Paths and options
    </MudText>

    <MudText Typo="Typo.body2"
             Color="Color.Secondary"
             Class="mb-3">
        These paths are the ones <em>Roastgate</em> sees: they must be mounted into its container, at the same location as on the host,
        because nginx reads the files you write through the same paths.
    </MudText>

    @if (_saveErrors.Count > 0)
    {
        <MudAlert Severity="Severity.Error"
                  Class="mb-3">
            @foreach (string error in _saveErrors)
            {
                <div>
                    @error
                </div>
            }
        </MudAlert>
    }

    @if (_saved)
    {
        <MudAlert Severity="Severity.Success"
                  Class="mb-3">
            Settings saved.
        </MudAlert>
    }

    <div class="rg-field-row">
        <MudTextField T="string"
                      @bind-Value="_nginxRoot"
                      Label="nginx directory"
                      Variant="Variant.Outlined" />

        <MudTextField T="string"
                      @bind-Value="_whitelistsDirectory"
                      Label="Whitelists directory"
                      Variant="Variant.Outlined" />

        <MudTextField T="string"
                      @bind-Value="_acmeWebroot"
                      Label="ACME webroot"
                      Variant="Variant.Outlined" />

        <MudTextField T="string"
                      @bind-Value="_letsEncryptDirectory"
                      Label="Let's Encrypt directory"
                      Variant="Variant.Outlined" />
    </div>

    <div class="rg-field-row mt-3">
        <MudSelect T="CertbotMode"
                   @bind-Value="_certbotMode"
                   Label="Certificate management"
                   Variant="Variant.Outlined">
            <MudSelectItem Value="CertbotMode.Embedded">
                Embedded certbot (renewed by Roastgate)
            </MudSelectItem>

            <MudSelectItem Value="CertbotMode.Host">
                certbot installed on the host
            </MudSelectItem>

            <MudSelectItem Value="CertbotMode.Disabled">
                Do not manage certificates
            </MudSelectItem>
        </MudSelect>

        <MudTextField T="string"
                      @bind-Value="_acmeEmail"
                      Label="Let's Encrypt e-mail"
                      Variant="Variant.Outlined" />
    </div>

    <div class="rg-editor-actions">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveSettingsAsync">
            Save settings
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   OnClick="RunDiagnosticsAsync"
                   Disabled="_isChecking">
            Check the host with these values
        </MudButton>
    </div>

    @if (_isChecking)
    {
        <MudProgressLinear Indeterminate="true"
                           Color="Color.Primary"
                           Class="mt-3" />
    }
    else if (_checks.Count > 0)
    {
        <div class="mt-3">
            <DiagnosticsTable Checks="_checks" />
        </div>
    }
</MudPaper>

<MudPaper Outlined="true"
          Elevation="0"
          Class="pa-4 mb-4">
    <MudText Typo="Typo.h6"
             Class="mb-1">
        Change the password
    </MudText>

    <MudText Typo="Typo.body2"
             Color="Color.Secondary"
             Class="mb-3">
        Every open session, on every device, is ended: you sign in again with the new password.
    </MudText>

    @if (_passwordErrors.Count > 0)
    {
        <MudAlert Severity="Severity.Error"
                  Class="mb-3">
            @foreach (string error in _passwordErrors)
            {
                <div>
                    @error
                </div>
            }
        </MudAlert>
    }

    <div class="rg-field-row">
        <MudTextField T="string"
                      @bind-Value="_currentPassword"
                      Label="Current password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" />

        <MudTextField T="string"
                      @bind-Value="_newPassword"
                      Label="New password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Immediate="true" />

        <MudTextField T="string"
                      @bind-Value="_confirmation"
                      Label="Repeat the new password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" />
    </div>

    @if (_newPassword.Length > 0)
    {
        @foreach (string problem in CredentialPolicy.ValidatePassword(_newPassword, _username))
        {
            <MudText Typo="Typo.caption"
                     Color="Color.Error"
                     Class="d-block mt-1">
                @problem
            </MudText>
        }
    }

    <div class="rg-editor-actions">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="ChangePasswordAsync"
                   Disabled="_isChangingPassword">
            Change the password
        </MudButton>
    </div>
</MudPaper>

<TwoFactorSection />

<PasskeySection />

<MudPaper Outlined="true"
          Elevation="0"
          Class="pa-4">
    <MudText Typo="Typo.h6"
             Class="mb-2">
        About this instance
    </MudText>

    <MudSimpleTable Dense="true"
                    Elevation="0">
        <tbody>
            <tr>
                <td>Signed in as</td><td>@_username</td>
            </tr>

            <tr>
                <td>Version</td><td>@_version</td>
            </tr>

            <tr>
                <td>Host commands</td><td>@(Options.HostExecMode == HostExecMode.Nsenter ? "run in the host namespaces (nsenter)" : "run inside this process (direct, development)")</td>
            </tr>

            <tr>
                <td>Data directory</td><td><code>@Options.DataDirectory</code></td>
            </tr>

            <tr>
                <td>Forwarded headers</td><td>@(Options.TrustForwardedHeaders ? "trusted (X-Forwarded-For, X-Forwarded-Proto)" : "ignored")</td>
            </tr>

            <tr>
                <td>Secure cookies</td><td>@(Options.SecureCookies ? "yes" : "no (set ROASTGATE_SECURE_COOKIES=true behind HTTPS)")</td>
            </tr>
        </tbody>
    </MudSimpleTable>
</MudPaper>
