@if (_snapshot == null)
{
    <MudProgressLinear Indeterminate="true"/>
}
else
{
    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Wrap="Wrap.Wrap"
              Spacing="2"
              Class="mb-2">
        <MudToggleGroup T="TimeSpan?"
                        Value="_preset"
                        ValueChanged="OnPresetChangedAsync"
                        Size="Size.Small"
                        Outlined="true">
            <MudToggleItem Value="@((TimeSpan?)TimeSpan.FromHours(1))"
                           Text="1 h"/>

            <MudToggleItem Value="@((TimeSpan?)TimeSpan.FromDays(1))"
                           Text="24 h"/>

            <MudToggleItem Value="@((TimeSpan?)TimeSpan.FromDays(7))"
                           Text="7 days"/>

            <MudToggleItem Value="@((TimeSpan?)TimeSpan.FromDays(30))"
                           Text="30 days"/>
        </MudToggleGroup>

        <MudDatePicker Label="Since"
                       Date="_customDate"
                       DateChanged="OnDateChangedAsync"
                       MaxDate="DateTime.Today"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"/>
    </MudStack>
    
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }

    <div class="traffic-map-frame">
        <div class="traffic-map" @ref="_mapContainer"></div>

        <div class="traffic-map-zoom">
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           OnClick="() => ZoomByAsync(1.5)"
                           aria-label="Zoom in"/>

            <MudIconButton Icon="@Icons.Material.Filled.Remove"
                           Size="Size.Small"
                           OnClick="() => ZoomByAsync(1 / 1.5)"
                           aria-label="Zoom out"/>

            <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong"
                           Size="Size.Small"
                           OnClick="ResetZoomAsync"
                           aria-label="Reset zoom"/>
        </div>
    </div>

    <MudText Typo="Typo.caption">
        <MudLink Href="https://db-ip.com"
                 Target="_blank">
            IP Geolocation by DB-IP
        </MudLink>
    </MudText>

    <MudTable Items="_points">
        <HeaderContent>
            <MudTh>City</MudTh>
            <MudTh>Country</MudTh>
            <MudTh>Requests</MudTh>
            <MudTh>Addresses</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.City</MudTd>
            <MudTd>@context.Country</MudTd>
            <MudTd>@context.Requests</MudTd>
            <MudTd>@context.Addresses</MudTd>
        </RowTemplate>

        <NoRecordsContent>
            No traffic for this period
        </NoRecordsContent>
    </MudTable>

    <MudText>
        @_snapshot.UnlocatedRequests unlocated requests
    </MudText>
}
