<div class="rg-page-header">
    <div>
        <MudText Typo="Typo.h4">
            @(_isNew ? "New whitelist" : _name)
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary">
            <a href="/whitelists">
                Whitelists
            </a>

            @if (!_isNew)
            {
                <span>
                    &middot; <a href="@("/whitelists/raw?name=" + Uri.EscapeDataString(_name))">edit as raw text</a> &middot; <a href="@("/backups?area=Whitelists&name=" + Uri.EscapeDataString(_name))">history</a>
                </span>
            }
        </MudText>
    </div>
</div>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error">
        That whitelist does not exist or cannot be read. <a href="/whitelists">Back to the list</a>.
    </MudAlert>

    return;
}

@if (_unsupported.Count > 0)
{
    <MudAlert Severity="Severity.Warning"
              Class="mb-4">
        <div>
            This file contains more than a list of <code>allow</code> lines, so the list editor would lose content. Edit it as raw text instead:
        </div>

        <ul>
            @foreach (string reason in _unsupported)
            {
                <li>
                    @reason
                </li>
            }
        </ul>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="@("/whitelists/raw?name=" + Uri.EscapeDataString(_name))"
                   Class="mt-2">
            Open the raw editor
        </MudButton>
    </MudAlert>

    return;
}

<ResultAlert Result="_result"
             Class="mb-4" />

@if (_isNew)
{
    <MudTextField T="string"
                  @bind-Value="_name"
                  Label="Name"
                  Variant="Variant.Outlined"
                  Class="mb-4"
                  HelperText="For example alice (the .conf extension is added)" />
}

<MudPaper Outlined="true"
          Elevation="0"
          Class="pa-4 mb-4">
    <MudText Typo="Typo.h6"
             Class="mb-2">
        Allowed addresses
    </MudText>

    @if (_rows.Count == 0)
    {
        <MudText Color="Color.Secondary"
                 Class="mb-2">
            No address yet. An empty whitelist allows nobody once it is used with <code>deny all;</code>.
        </MudText>
    }

    @for (int index = 0; index < _rows.Count; index++)
    {
        int position = index;
        EntryRow row = _rows[position];
        IReadOnlyList<WhitelistProblem> problems = ProblemsFor(position);
        bool hasError = problems.Any((WhitelistProblem problem) => problem.Severity == ProblemSeverity.Error);

        <div class="rg-entry-row">
            <MudTextField T="string"
                          @bind-Value="row.Address"
                          Immediate="true"
                          Label="Address"
                          Variant="Variant.Outlined"
                          Placeholder="203.0.113.7 or 10.0.0.0/8 or 2001:db8::/32"
                          Error="hasError"
                          ErrorText="@(hasError ? problems[0].Message : null)"
                          HelperText="@(!hasError && problems.Count > 0 ? problems[0].Message : null)" />

            <MudTextField T="string"
                          @bind-Value="row.Comment"
                          Immediate="true"
                          Label="Comment"
                          Variant="Variant.Outlined"
                          Placeholder="alice at home" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           OnClick="@(() => RemoveRow(position))"
                           Size="Size.Small"
                           aria-label="@("Remove address " + (position + 1))" />
        </div>
    }

    <div class="rg-entry-actions">
        <MudButton Variant="Variant.Outlined"
                   OnClick="AddRow"
                   StartIcon="@Icons.Material.Filled.Add">
            Add address
        </MudButton>

        @if (!string.IsNullOrEmpty(ClientAddress))
        {
            <MudButton Variant="Variant.Outlined"
                       OnClick="AddMyAddress">
                Add my address (@ClientAddress)
            </MudButton>
        }
    </div>

    @if (!string.IsNullOrEmpty(ClientAddress))
    {
        <MudText Typo="Typo.caption"
                 Color="Color.Secondary"
                 Class="d-block mt-3">
            This is your address as Roastgate sees it. Behind a reverse proxy it may be the proxy's address:
            enable <code>ROASTGATE_TRUST_FORWARDED_HEADERS</code> only if Roastgate can be reached through your own proxy alone.
        </MudText>
    }
</MudPaper>

<MudPaper Outlined="true"
          Elevation="0"
          Class="pa-4 mb-4">
    <MudText Typo="Typo.h6"
             Class="mb-2">
        Paste several addresses
    </MudText>

    <MudTextField T="string"
                  @bind-Value="_paste"
                  Lines="3"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  Placeholder="One per line, or separated by spaces and commas. Lines like &quot;allow 1.2.3.4;&quot; work too." />

    <MudButton Variant="Variant.Outlined"
               OnClick="AddPasted"
               Disabled="string.IsNullOrWhiteSpace(_paste)"
               Class="mt-3">
        Add them to the list
    </MudButton>
</MudPaper>

@if (!_isNew && _details is not null)
{
    <MudPaper Outlined="true"
              Elevation="0"
              Class="pa-4 mb-4">
        <MudText Typo="Typo.h6"
                 Class="mb-2">
            How to use it
        </MudText>

        <MudText Class="mb-2">
            Add these lines inside the <code>server</code> or <code>location</code> you want to restrict:
        </MudText>

        <pre class="rg-output">@_details.IncludeSnippet
deny all;</pre>

        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   Class="mt-3"
                   OnClick="CopySnippetAsync">
            @(_copied ? "Copied" : "Copy")
        </MudButton>

        <MudText Typo="Typo.subtitle1"
                 Class="mt-4 mb-1">
            Used by
        </MudText>

        @if (_details.Usage.Count == 0)
        {
            <MudText Color="Color.Secondary">
                Nothing includes this whitelist yet, so it has no effect.
            </MudText>
        }
        else
        {
            <ul>
                @foreach (WhitelistUsage usage in _details.Usage)
                {
                    <li>
                        <a href="@UsageUrl(usage)">@usage.FileName</a> (line @usage.Line)

                        @if (usage.ViaWildcard)
                        {
                            <span>
                                through a wildcard include
                            </span>
                        }

                        @if (!usage.FileEnabled)
                        {
                            <span>
                                &middot; <em>not active: that file is disabled</em>
                            </span>
                        }
                    </li>
                }
            </ul>
        }
    </MudPaper>
}

<div class="rg-editor-actions">
    <MudSwitch T="bool"
               @bind-Value="_reload"
               Color="Color.Primary"
               Label="Reload nginx after saving" />

    <MudSpacer />

    @if (!_isNew)
    {
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   OnClick="DeleteAsync"
                   Disabled="_isBusy">
            Delete
        </MudButton>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="SaveAsync"
               Disabled="_isBusy || HasBlockingError">
        Save
    </MudButton>
</div>
