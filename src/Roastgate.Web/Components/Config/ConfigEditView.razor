<div class="rg-page-header">
    <div>
        <MudText Typo="Typo.h4">
            @(_isNew ? "New " + Info.Singular : _name)
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary">
            <a href="@Info.ListRoute">
                @Info.Title
            </a>

            @if (!_isNew)
            {
                <span>
                    &middot; <a href="@Info.BackupsUrl(_name)">history</a>
                </span>
            }

            @if (!_isNew && _file is not null && Area != ConfigArea.Whitelists && SiteMetadataFormat.IsWizardFile(_file.Content))
            {
                <span>
                    &middot; <a href="@Info.WizardUrl(_name)">open in the wizard</a> (hand edits will be replaced)
                </span>
            }
            else if (!_isNew && _file is not null && Area != ConfigArea.Whitelists)
            {
                <span>
                    &middot; <a href="@Info.WizardUrl(_name)" data-testid="import-link">import into the wizard</a> (the file is regenerated, a backup is kept)
                </span>
            }

            @if (Area == ConfigArea.Whitelists && !_isNew)
            {
                <span>
                    &middot; <a href="@("/whitelists/edit?name=" + Uri.EscapeDataString(_name))">edit as a list</a>
                </span>
            }

            @if (!_isNew && _file is not null && Area != ConfigArea.Whitelists)
            {
                <span>
                    &middot; @(_file.Enabled ? "enabled" : "disabled")
                </span>
            }
        </MudText>
    </div>
</div>

@if (_notFound)
{
    <MudAlert Severity="Severity.Error">
        That file does not exist or cannot be read. <a href="@Info.ListRoute">Back to the list</a>.
    </MudAlert>

    return;
}

<ResultAlert Result="_result"
             Class="mb-4" />

@if (_isNew)
{
    <MudTextField T="string"
                  @bind-Value="_name"
                  Label="File name"
                  Variant="Variant.Outlined"
                  Class="mb-4"
                  HelperText="@(Area == ConfigArea.Sites ? "For example example.com" : "For example app.example.com.conf (.conf is added when missing)")" />
}

@if (_isLoaded)
{
    <div class="rg-editor">
        @if (_monacoReady)
        {
            <StandaloneCodeEditor @ref="_editor"
                                  Id="@("config-editor-" + Area)"
                                  ConstructionOptions="BuildOptions"
                                  OnDidInit="OnEditorInitAsync" />
        }
        else
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary" />
        }
    </div>
}

<div class="rg-editor-actions">
    <MudSwitch T="bool"
               @bind-Value="_reload"
               Color="Color.Primary"
               Label="Reload nginx after saving" />

    <MudSpacer />

    @if (!_isNew)
    {
        @if (Area != ConfigArea.Whitelists && _file is not null)
        {
            <MudButton Variant="Variant.Outlined"
                       OnClick="ToggleEnabledAsync"
                       Disabled="_isBusy">
                @(_file.Enabled ? "Disable" : "Enable")
            </MudButton>
        }

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   OnClick="DeleteAsync"
                   Disabled="_isBusy">
            Delete
        </MudButton>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="SaveAsync"
               Disabled="_isBusy || !_editorReady">
        Save
    </MudButton>
</div>
