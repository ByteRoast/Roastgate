@if (Result is not null)
{
    <MudAlert Severity="Severity"
              Class="@Class"
              Variant="Variant.Outlined">
        <div>
            @Result.Message
        </div>

        @if (!string.IsNullOrWhiteSpace(Result.NginxOutput))
        {
            <pre class="rg-output">@Result.NginxOutput</pre>
        }
    </MudAlert>
}
