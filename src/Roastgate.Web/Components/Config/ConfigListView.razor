<div class="rg-page-header">
    <div>
        <MudText Typo="Typo.h4">
            @Info.Title
        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary">
            @Info.Description
        </MudText>
    </div>

    <div class="rg-page-actions">
        <MudButton Variant="Variant.Outlined"
                   OnClick="TestAsync"
                   Disabled="_isBusy">
            Test nginx
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   OnClick="ReloadAsync"
                   Disabled="_isBusy">
            Reload nginx
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Href="@Info.EditUrl(null)">
            New from raw text
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="@Info.WizardUrl(null)">
            New @Info.Singular
        </MudButton>
    </div>
</div>

<ResultAlert Result="_result"
             Class="mb-4" />

@if (_listing is not null && !_listing.DirectoryExists)
{
    <MudAlert Severity="Severity.Warning"
              Class="mb-4">
        The directory <code>@_listing.Directory</code> does not exist or is not visible to Roastgate.

        @if (Area == ConfigArea.Whitelists)
        {
            <span>
                It is created when you save the first whitelist.
            </span>
        }
        else
        {
            <span>
                Mount your nginx directory into the container, or fix the path in the settings.
            </span>
        }
    </MudAlert>
}

<MudTable T="ConfigEntry"
          Items="_listing?.Entries"
          Loading="_listing is null"
          Hover="true"
          Dense="true"
          Outlined="true"
          Elevation="0"
          Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>
            Name
        </MudTh>

        @if (Area != ConfigArea.Whitelists)
        {
            <MudTh>
                Enabled
            </MudTh>
        }

        <MudTh>
            Size
        </MudTh>

        <MudTh>
            Modified
        </MudTh>

        <MudTh>
        </MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Name">
            <a href="@OpenUrl(context)">
                @context.Name
            </a>

            @if (context.Wizard)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Class="ml-2"
                         title="Created by the wizard: it can be reopened as a form">
                    wizard
                </MudChip>
            }
        </MudTd>

        @if (Area != ConfigArea.Whitelists)
        {
            <MudTd DataLabel="Enabled">
                <MudSwitch T="bool"
                           Value="context.Enabled"
                           ValueChanged="@((bool value) => SetEnabledAsync(context, value))"
                           Color="Color.Primary"
                           Disabled="_isBusy"
                           aria-label="@("Enable " + context.Name)" />
            </MudTd>
        }

        <MudTd DataLabel="Size">
            @FormatSize(context.SizeBytes)
        </MudTd>

        <MudTd DataLabel="Modified">
            @context.ModifiedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </MudTd>

        <MudTd Style="text-align: right">
            @if (context.Wizard)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Code"
                               Href="@Info.EditUrl(context.Name)"
                               Size="Size.Small"
                               aria-label="@("Edit " + context.Name + " as raw text")"
                               title="Edit as raw text" />
            }

            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Href="@OpenUrl(context)"
                           Size="Size.Small"
                           aria-label="@("Edit " + context.Name)" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           OnClick="@(() => DeleteAsync(context))"
                           Size="Size.Small"
                           Disabled="_isBusy"
                           aria-label="@("Delete " + context.Name)" />
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText>
            No @Info.Singular yet.
        </MudText>
    </NoRecordsContent>
</MudTable>
