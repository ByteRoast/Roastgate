@page "/audit-log"
@attribute [Authorize]

<PageTitle>
    Audit log · Roastgate
</PageTitle>

<MudText Typo="Typo.h4"
         GutterBottom="true">
    Audit log
</MudText>

<MudText Typo="Typo.body2"
         Color="Color.Secondary"
         Class="mb-4">
    The 200 most recent actions, newest first.
</MudText>

<MudTable T="AuditEntry"
          Items="_entries"
          Loading="_entries is null"
          Hover="true"
          Dense="true"
          Outlined="true"
          Elevation="0"
          Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>
            Time
        </MudTh>

        <MudTh>
            Actor
        </MudTh>

        <MudTh>
            Action
        </MudTh>

        <MudTh>
            Target
        </MudTh>

        <MudTh>
            Result
        </MudTh>

        <MudTh>
            Details
        </MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Time">
            @context.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        </MudTd>

        <MudTd DataLabel="Actor">
            @context.Actor
        </MudTd>

        <MudTd DataLabel="Action">
            <code>
                @context.Action
            </code>
        </MudTd>

        <MudTd DataLabel="Target">
            @context.Target
        </MudTd>

        <MudTd DataLabel="Result">
            @if (context.Success)
            {
                <MudText Color="Color.Success">
                    OK
                </MudText>
            }
            else
            {
                <MudText Color="Color.Error">
                    Failed
                </MudText>
            }
        </MudTd>

        <MudTd DataLabel="Details">
            @context.Details
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText>
            No action has been recorded yet.
        </MudText>
    </NoRecordsContent>
</MudTable>
