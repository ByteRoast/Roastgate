@page "/"
@attribute [Authorize]
@inject NginxProbe Probe
@inject RoastgateOptions Options
@inject IConfigStore Store
@inject CurrentUser User

<PageTitle>Dashboard · Roastgate</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard Outlined="true">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">nginx on the host</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (_probe is null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_probe.Available)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">
                        nginx @(_probe.Version ?? "(unknown version)") is reachable.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Error" Dense="true">nginx is not reachable from Roastgate.</MudAlert>
                    @if (_probe.Output.Length > 0)
                    {
                        <pre class="rg-output">@_probe.Output</pre>
                    }
                }
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshAsync" Disabled="_isChecking">Check again</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="TestAsync" Disabled="_isChecking">Test configuration</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="_isChecking">Reload nginx</MudButton>
            </MudCardActions>
        </MudCard>
        <ResultAlert Result="_result" Class="mt-4" />
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Outlined="true">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Runtime</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudSimpleTable Dense="true" Hover="false" Elevation="0">
                    <tbody>
                        <tr><td>Host execution</td><td>@Options.HostExecMode</td></tr>
                        <tr><td>Data directory</td><td><code>@Options.DataDirectory</code></td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private NginxProbeResult? _probe;
    private bool _isChecking;
    private ConfigResult? _result;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task TestAsync()
    {
        _result = await Store.TestNginxAsync(await User.GetNameAsync());
    }

    private async Task ReloadAsync()
    {
        _result = await Store.ReloadNginxAsync(await User.GetNameAsync());
    }

    private async Task RefreshAsync()
    {
        _isChecking = true;
        _probe = null;
        try
        {
            _probe = await Probe.ProbeAsync();
        }
        finally
        {
            _isChecking = false;
        }
    }
}
