@page "/backups"
@attribute [Authorize]

<PageTitle>Backups · Roastgate</PageTitle>

<BackupsView Area="@Area" Name="@Name" />

@code {
    [SupplyParameterFromQuery(Name = "area")]
    private string? Area { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    private string? Name { get; set; }
}
