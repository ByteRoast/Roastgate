@page "/setup"
@layout SetupLayout
@attribute [AllowAnonymous]
@inject ISetupService SetupState
@inject LoginThrottle Throttle
@inject HostDiagnostics Diagnostics
@inject SignInTicketService Tickets
@inject NavigationManager Navigation

<PageTitle>Setup · Roastgate</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Set up Roastgate</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Step @_step of @StepCount: @StepTitle</MudText>
<MudProgressLinear Value="@(_step * 100.0 / StepCount)" Color="Color.Primary" Class="mb-6" />

@if (_errors.Count > 0)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @foreach (string error in _errors)
        {
            <div>@error</div>
        }
    </MudAlert>
}

@switch (_step)
{
    case 1:
        <MudText Class="mb-3">
            Roastgate is not configured yet. Enter the setup token printed in the container logs
            (<code>docker logs roastgate</code>) or provided through <code>ROASTGATE_SETUP_TOKEN</code>.
        </MudText>
        <MudTextField T="string" @bind-Value="_token" Label="Setup token" Variant="Variant.Outlined" InputType="InputType.Password" Immediate="true" />
        <div class="rg-step-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="VerifyToken">Continue</MudButton>
        </div>
        break;

    case 2:
        <MudText Class="mb-3">Create the administrator account. It is the only account Roastgate has.</MudText>
        <MudTextField T="string" @bind-Value="_username" Label="Username" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Immediate="true" Class="mb-3" />
        @if (_password.Length > 0)
        {
            IReadOnlyList<string> passwordProblems = CredentialPolicy.ValidatePassword(_password, _username);
            @foreach (string problem in passwordProblems)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">@problem</MudText>
            }
        }
        <MudTextField T="string" @bind-Value="_confirmation" Label="Repeat the password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mt-3" />
        <div class="rg-step-actions">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => GoTo(1))">Back</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueFromAccount">Continue</MudButton>
        </div>
        break;

    case 3:
        <MudText Class="mb-3">Tell Roastgate where nginx lives. These paths must be visible inside the Roastgate container.</MudText>
        <MudTextField T="string" @bind-Value="_nginxRoot" Label="nginx directory" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_whitelistsDirectory" Label="Whitelists directory" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_acmeWebroot" Label="ACME webroot (Let's Encrypt challenges)" Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect T="CertbotMode" @bind-Value="_certbotMode" Label="Certificate management" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="CertbotMode.Embedded">Embedded certbot (shipped with Roastgate)</MudSelectItem>
            <MudSelectItem Value="CertbotMode.Host">certbot installed on the host</MudSelectItem>
            <MudSelectItem Value="CertbotMode.Disabled">Do not manage certificates</MudSelectItem>
        </MudSelect>
        <MudTextField T="string" @bind-Value="_acmeEmail" Label="Let's Encrypt e-mail (optional)" Variant="Variant.Outlined" />
        <div class="rg-step-actions">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => GoTo(2))">Back</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueFromPathsAsync">Continue</MudButton>
        </div>
        break;

    case 4:
        <MudText Class="mb-3">Roastgate checked your host. Errors do not block the setup, but they must be fixed before configs can be managed.</MudText>
        @if (_isChecking)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0" Outlined="true">
                <tbody>
                    @foreach (DiagnosticCheck check in _checks)
                    {
                        <tr>
                            <td class="rg-check-icon">
                                @switch (check.Status)
                                {
                                    case DiagnosticStatus.Ok:
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Title="OK" />
                                        break;
                                    case DiagnosticStatus.Warning:
                                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Title="Warning" />
                                        break;
                                    default:
                                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Title="Error" />
                                        break;
                                }
                            </td>
                            <td><strong>@check.Name</strong></td>
                            <td>@check.Message</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        <div class="rg-step-actions">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => GoTo(3))">Back</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="RunDiagnosticsAsync" Disabled="_isChecking">Check again</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => GoTo(5))" Disabled="_isChecking">Continue</MudButton>
        </div>
        break;

    default:
        <MudText Class="mb-3">Review and finish. You will be signed in automatically.</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Outlined="true">
            <tbody>
                <tr><td>Administrator</td><td>@_username.Trim().ToLowerInvariant()</td></tr>
                <tr><td>nginx directory</td><td><code>@_nginxRoot</code></td></tr>
                <tr><td>Whitelists directory</td><td><code>@_whitelistsDirectory</code></td></tr>
                <tr><td>ACME webroot</td><td><code>@_acmeWebroot</code></td></tr>
                <tr><td>Certificates</td><td>@_certbotMode</td></tr>
                <tr><td>Let's Encrypt e-mail</td><td>@(string.IsNullOrWhiteSpace(_acmeEmail) ? "(none)" : _acmeEmail)</td></tr>
            </tbody>
        </MudSimpleTable>
        <div class="rg-step-actions">
            <MudButton Variant="Variant.Outlined" OnClick="@(() => GoTo(4))">Back</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FinishAsync" Disabled="_isFinishing">Finish setup</MudButton>
        </div>
        break;
}

@code {
    private const int StepCount = 5;
    private const string TokenThrottleKey = "setup-token";

    private static readonly string[] StepTitles = ["Setup token", "Administrator account", "Paths and options", "Host diagnostics", "Summary"];

    private int _step = 1;
    private List<string> _errors = [];
    private IReadOnlyList<DiagnosticCheck> _checks = [];
    private bool _isChecking;
    private bool _isFinishing;

    private string _token = string.Empty;
    private string _username = "admin";
    private string _password = string.Empty;
    private string _confirmation = string.Empty;
    private string _nginxRoot = "/etc/nginx";
    private string _whitelistsDirectory = "/etc/nginx/whitelists";
    private string _acmeWebroot = "/var/www/certbot";
    private CertbotMode _certbotMode = CertbotMode.Embedded;
    private string? _acmeEmail;

    private string StepTitle => StepTitles[_step - 1];

    private AppSettings BuildSettings()
    {
        return new AppSettings
        {
            NginxRoot = _nginxRoot.Trim(),
            WhitelistsDirectory = _whitelistsDirectory.Trim(),
            AcmeWebroot = _acmeWebroot.Trim(),
            CertbotMode = _certbotMode,
            AcmeEmail = string.IsNullOrWhiteSpace(_acmeEmail) ? null : _acmeEmail.Trim(),
        };
    }

    private void GoTo(int step)
    {
        _errors = [];
        _step = step;
    }

    private void VerifyToken()
    {
        _errors = [];
        if (Throttle.IsBlocked(TokenThrottleKey, out TimeSpan retryAfter))
        {
            _errors.Add($"Too many wrong tokens. Try again in {Math.Ceiling(retryAfter.TotalMinutes)} minute(s).");
            return;
        }

        if (!SetupState.VerifyToken(_token))
        {
            Throttle.RecordFailure(TokenThrottleKey);
            _errors.Add("The setup token is not valid.");
            return;
        }

        Throttle.Reset(TokenThrottleKey);
        _step = 2;
    }

    private void ContinueFromAccount()
    {
        _errors = [];
        _errors.AddRange(CredentialPolicy.ValidateUsername(_username.Trim().ToLowerInvariant()));
        _errors.AddRange(CredentialPolicy.ValidatePassword(_password, _username.Trim().ToLowerInvariant()));
        if (_password != _confirmation)
        {
            _errors.Add("The two passwords do not match.");
        }

        if (_errors.Count == 0)
        {
            _step = 3;
        }
    }

    private async Task ContinueFromPathsAsync()
    {
        _errors = [];
        _errors.AddRange(BuildSettings().Validate());
        if (_errors.Count > 0)
        {
            return;
        }

        _step = 4;
        await RunDiagnosticsAsync();
    }

    private async Task RunDiagnosticsAsync()
    {
        _isChecking = true;
        try
        {
            _checks = await Diagnostics.RunAsync(BuildSettings());
        }
        finally
        {
            _isChecking = false;
        }
    }

    private async Task FinishAsync()
    {
        _errors = [];
        _isFinishing = true;
        try
        {
            SetupResult result = await SetupState.CompleteAsync(new SetupRequest(_token, _username, _password, BuildSettings()));
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                return;
            }

            string ticket = Tickets.Issue(_username.Trim().ToLowerInvariant());
            Navigation.NavigateTo($"/sign-in/{ticket}", forceLoad: true);
        }
        finally
        {
            _isFinishing = false;
        }
    }
}
