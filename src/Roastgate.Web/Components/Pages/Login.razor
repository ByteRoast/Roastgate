@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<AppPageTitle Title="Sign in" />

@if (NoticeText is not null)
{
    <p class="rg-auth-notice"
       role="status">
        @NoticeText
    </p>
}

@if (_ticket is null)
{
    <h1 class="rg-auth-title">
        Sign in
    </h1>

    <EditForm Model="Input"
              FormName="login"
              OnValidSubmit="SignInAsync"
              Enhance="false"
              class="rg-auth-form">
        <DataAnnotationsValidator />

        <label for="username">
            Username
        </label>

        <InputText id="username"
                   @bind-Value="Input!.Username"
                   autocomplete="username"
                   autofocus />

        <label for="password">
            Password
        </label>

        <InputText id="password"
                   type="password"
                   @bind-Value="Input!.Password"
                   autocomplete="current-password" />

        @if (_error is not null)
        {
            <p class="rg-auth-error"
               role="alert">
                @_error
            </p>
        }

        <button type="submit"
                class="rg-auth-button">
            Sign in
        </button>
    </EditForm>

    <div class="rg-auth-alternative">
        <span>
            or
        </span>

        <button type="button"
                class="rg-auth-button rg-auth-button-secondary"
                data-passkey-signin
                data-passkey-error="passkey-error">
            Sign in with a passkey
        </button>

        <p id="passkey-error"
           class="rg-auth-error"
           role="alert"
           hidden>
        </p>
    </div>
}
else
{
    <h1 class="rg-auth-title">
        Two-step verification
    </h1>

    <p class="rg-auth-help">
        @SecondStepHelp
    </p>

    <EditForm Model="Code"
              FormName="login-code"
              OnValidSubmit="VerifyCodeAsync"
              Enhance="false"
              class="rg-auth-form">
        <DataAnnotationsValidator />

        <InputText id="ticket"
                   type="hidden"
                   @bind-Value="Code!.Ticket" />

        @if (_totpEnabled)
        {
            <label for="code">
                Authentication code
            </label>

            <InputText id="code"
                       @bind-Value="Code!.Code"
                       autocomplete="one-time-code"
                       inputmode="text"
                       autofocus />
        }

        @if (_error is not null)
        {
            <p class="rg-auth-error"
               role="alert">
                @_error
            </p>
        }

        @if (_totpEnabled)
        {
            <button type="submit"
                    class="rg-auth-button">
                Verify
            </button>
        }
    </EditForm>

    @if (_hasPasskeys)
    {
        <div class="rg-auth-alternative">
            @if (_totpEnabled)
            {
                <span>
                    or
                </span>
            }

            <button type="button"
                    class="rg-auth-button rg-auth-button-secondary"
                    data-passkey-signin
                    data-passkey-ticket="ticket"
                    data-passkey-error="passkey-error">
                Use a passkey
            </button>

            <p id="passkey-error"
               class="rg-auth-error"
               role="alert"
               hidden>
            </p>
        </div>
    }

    <p class="rg-auth-help">
        <a href="/login">
            Start again
        </a>
    </p>
}
