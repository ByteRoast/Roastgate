@page "/error"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>
    Error · Roastgate
</PageTitle>

<h1 class="rg-auth-title">
    Something went wrong
</h1>

<p>
    An error occurred while processing your request.
</p>

@if (RequestId is not null)
{
    <p>
        Request ID: <code>@RequestId</code>
    </p>
}

<p>
    <a href="/">
        Back to the dashboard
    </a>
</p>
